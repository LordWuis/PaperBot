# Provision Neon Postgres from your Vercel project's Storage tab.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=https://YOUR-PROJECT.vercel.app
DEVELOPER_EMAIL=developer@example.com
FREE_USER_EMAIL=main@example.com
RESEND_API_KEY=re_replace_me
DEFAULT_EMAIL=support@persevex.com
HR_EMAIL=hr@persevex.com
BCC_EMAIL=startling550@gmail.com
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace-with-a-separate-random-secret
# Live onboarding: share the sheet with the service account as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
ONBOARDING_SHEET_ID=YOUR_SHEET_ID
ONBOARDING_SHEET_GID=YOUR_TAB_GID
ONBOARDING_RANGE='OB'!A:ZZ
# Exact sheet header labels; override to match your existing onboarding sheet.
ONBOARDING_COLUMNS={"name":"Name","email":"Email","month":"Month","domain":"Domain"}
# Preserve the existing QR destination. See README before switching to /verification.
CERTIFICATE_VERIFY_URL=https://www.persevex.com/verification
